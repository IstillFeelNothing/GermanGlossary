<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GermanyGlossary.ViewModels"
             x:Class="GermanyGlossary.Views.FlashcardsPage"
             x:DataType="vm:FlashcardsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Картки">

    <Grid RowDefinitions="Auto,*" Padding="20,20,20,20" MaximumWidthRequest="640">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Картки" Style="{StaticResource PageTitle}" VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding ProgressText}"
                   IsVisible="{Binding HasCard}"
                   Style="{StaticResource Muted}"
                   FontFamily="OpenSansSemibold"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmpty}" VerticalOptions="Center" Spacing="8">
            <Label Text="Ще немає слів"
                   FontFamily="OpenSansSemibold"
                   FontSize="20"
                   HorizontalTextAlignment="Center" />
            <Label Text="Додайте слова на вкладці «Слова», і тут з'являться картки."
                   Style="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Session finished -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsFinished}" VerticalOptions="Center" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Text="Готово!" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding SummaryText}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Style="{StaticResource Card}" Padding="16,18">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding KnownCount}"
                               FontFamily="OpenSansSemibold"
                               FontSize="32"
                               TextColor="{StaticResource Success}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="з першого разу" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,18">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding MissedCount}"
                               FontFamily="OpenSansSemibold"
                               FontSize="32"
                               TextColor="{StaticResource Danger}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="треба повторити" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Почати знову" Command="{Binding RestartCommand}" />
        </VerticalStackLayout>

        <!-- Active card -->
        <Grid Grid.Row="1" IsVisible="{Binding HasCard}" RowDefinitions="Auto,*,Auto" RowSpacing="20" Padding="0,16,0,0">
            <ProgressBar Progress="{Binding Progress}" HeightRequest="6" />

            <Border x:Name="Card"
                    Grid.Row="1"
                    Padding="24"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Stroke}"
                    StrokeShape="RoundRectangle 28">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCardTapped" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Style="{StaticResource Badge}" HorizontalOptions="Start">
                        <Label Text="{Binding KindLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </Border>

                    <!-- Front -->
                    <Label Grid.Row="1"
                           IsVisible="{Binding IsFront}"
                           Text="{Binding FrontText}"
                           FontFamily="OpenSansSemibold"
                           FontSize="40"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />

                    <Label Grid.Row="2"
                           IsVisible="{Binding IsFront}"
                           Text="Торкніться, щоб перевернути"
                           FontSize="13"
                           TextColor="{StaticResource TextTertiary}"
                           HorizontalTextAlignment="Center" />

                    <!-- Back -->
                    <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsFlipped}" VerticalOptions="Center" Spacing="14">
                        <Label FontSize="22" HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ArticlePrefix}"
                                          TextColor="{Binding Article, Converter={StaticResource ArticleColor}}"
                                          FontFamily="OpenSansSemibold" />
                                    <Span Text="{Binding FrontText}" TextColor="{StaticResource TextSecondary}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="{Binding Translation}"
                               FontFamily="OpenSansSemibold"
                               FontSize="34"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding Details}"
                               Style="{StaticResource Muted}"
                               HorizontalTextAlignment="Center" />

                        <Border IsVisible="{Binding HasExample}"
                                BackgroundColor="{StaticResource SurfaceRaised}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="16,12"
                                Margin="0,8,0,0">
                            <Label Text="{Binding Example}"
                                   FontAttributes="Italic"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Rating: shown only after the card is flipped -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsFlipped}">
                <Button Text="Не знаю"
                        Style="{StaticResource DontKnowButton}"
                        Command="{Binding DontKnowCommand}" />
                <Button Grid.Column="1"
                        Text="Знаю"
                        Style="{StaticResource KnowButton}"
                        Command="{Binding KnowCommand}" />
            </Grid>

            <!-- Keeps the card the same height before and after the flip -->
            <BoxView Grid.Row="2" IsVisible="{Binding IsFront}" HeightRequest="56" Color="Transparent" />
        </Grid>
    </Grid>

</ContentPage>
