<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GermanyGlossary.ViewModels"
             x:Class="GermanyGlossary.Views.WordEditPage"
             x:DataType="vm:WordEditViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="4" MaximumWidthRequest="600">

            <Label Text="Тип" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding Kinds}" SelectedIndex="{Binding SelectedKindIndex}" />

            <Label Text="Слово німецькою" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Text}" Placeholder="Apfel" />

            <Label Text="Переклад" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Translation}" Placeholder="яблуко" />

            <Label Text="Приклад" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding Example}" Placeholder="Ich esse einen Apfel." AutoSize="TextChanges" />

            <!-- Noun -->
            <VerticalStackLayout IsVisible="{Binding IsNoun}" Spacing="4">
                <Label Text="Артикль" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Articles}" SelectedIndex="{Binding ArticleIndex}" />

                <Label Text="Множина" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Plural}" Placeholder="Äpfel" />
            </VerticalStackLayout>

            <!-- Verb -->
            <VerticalStackLayout IsVisible="{Binding IsVerb}" Spacing="4">
                <Label Text="Präteritum" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Praeteritum}" Placeholder="kam an" />

                <Label Text="Partizip II" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding PartizipII}" Placeholder="angekommen" />

                <Label Text="Допоміжне дієслово" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding Auxiliaries}" SelectedIndex="{Binding AuxiliaryIndex}" />

                <HorizontalStackLayout Spacing="4" Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding IsSeparable}" />
                    <Label Text="Відокремлюваний префікс" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Adjective -->
            <VerticalStackLayout IsVisible="{Binding IsAdjective}" Spacing="4">
                <Label Text="Comparative" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Comparative}" Placeholder="besser" />

                <Label Text="Superlative" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Superlative}" Placeholder="am besten" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="#C62828"
                   Margin="0,8,0,0"
                   IsVisible="{Binding HasError}" />

            <Button Text="Зберегти" Command="{Binding SaveCommand}" Margin="0,16,0,0" />

            <Button Text="Видалити"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditMode}"
                    BackgroundColor="Transparent"
                    TextColor="#C62828"
                    BorderColor="#C62828"
                    BorderWidth="1" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
