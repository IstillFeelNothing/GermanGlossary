<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GermanyGlossary.ViewModels"
             xmlns:controls="clr-namespace:GermanyGlossary.Views.Controls"
             xmlns:local="clr-namespace:GermanyGlossary"
             x:Class="GermanyGlossary.Views.WordsPage"
             x:DataType="vm:WordsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="{OnPlatform Default=True, WinUI=False}"
             Title="Слова">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0,20,0,0">

        <!-- Centered top menu (Windows only; phones keep the bottom tab bar) -->
        <controls:TopNavBar CurrentRoute="{x:Static local:AppShell.WordsRoute}"
                            IsVisible="{OnPlatform Default=False, WinUI=True}"
                            Margin="0,0,0,20" />

        <!-- Header: title + word count, "Додати" pill on the right -->
        <Grid Grid.Row="1" Padding="20,0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                <Label Text="Словник" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding CountText}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="+  Додати"
                    Command="{Binding AddCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Search -->
        <Border Grid.Row="2" Style="{StaticResource Field}" Margin="20,20,20,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="⌕"
                       FontSize="22"
                       TextColor="{StaticResource TextTertiary}"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Пошук слова або перекладу"
                       ClearButtonVisibility="WhileEditing"
                       ReturnType="Search" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Words}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedWord}">
            <CollectionView.Header>
                <BoxView HeightRequest="4" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,64" Spacing="8">
                    <Label Text="{Binding EmptyTitle}"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptyMessage}"
                           Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WordListItem">
                    <!-- Outer grid absorbs the native selection highlight; the card itself stays rounded. -->
                    <Grid Padding="20,5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>

                        <Border Style="{StaticResource Card}">
                            <!-- No ColumnSpacing: the hidden stripe of non-nouns must not leave a gap; margins space things instead. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                <!-- Article color stripe for nouns -->
                                <BoxView Grid.RowSpan="2"
                                         Margin="0,0,12,0"
                                         WidthRequest="4"
                                         CornerRadius="2"
                                         IsVisible="{Binding HasArticle}"
                                         Color="{Binding Article, Converter={StaticResource ArticleColor}}" />

                                <Label Grid.Column="1" FontSize="18" LineBreakMode="TailTruncation">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ArticlePrefix}"
                                                  TextColor="{Binding Article, Converter={StaticResource ArticleColor}}"
                                                  FontFamily="OpenSansSemibold" />
                                            <Span Text="{Binding Text}" FontFamily="OpenSansSemibold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Translation}"
                                       Style="{StaticResource Muted}"
                                       LineBreakMode="TailTruncation" />

                                <Border Grid.Column="2"
                                        Grid.RowSpan="2"
                                        Style="{StaticResource Badge}"
                                        Margin="12,0,0,0"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding KindLabel}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
