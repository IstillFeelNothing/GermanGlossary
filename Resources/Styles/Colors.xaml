<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Surfaces (dark-only theme, inspired by strum.capital) -->
    <Color x:Key="Background">#0B0F14</Color>
    <Color x:Key="Surface">#161D26</Color>
    <Color x:Key="SurfaceRaised">#1E2732</Color>
    <Color x:Key="Stroke">#262F3B</Color>

    <!-- Accent -->
    <Color x:Key="Primary">#4439C9</Color>
    <Color x:Key="PrimaryPressed">#3A30B0</Color>
    <!-- Lighter tint of Primary for text/icons on dark surfaces (Primary itself is too dark to read there). -->
    <Color x:Key="PrimaryText">#9C95F5</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#A1A1A1</Color>
    <Color x:Key="TextTertiary">#6B7280</Color>

    <!-- Feedback -->
    <Color x:Key="Success">#4ADE80</Color>
    <Color x:Key="SuccessSoft">#12291D</Color>
    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="DangerSoft">#2C1518</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="WarningSoft">#2A2210</Color>
    <Color x:Key="PrimarySoft">#1D1A3D</Color>

    <!-- German article colors: der = blue, die = pink, das = green -->
    <Color x:Key="ArticleDer">#60A5FA</Color>
    <Color x:Key="ArticleDie">#F472B6</Color>
    <Color x:Key="ArticleDas">#4ADE80</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Transparent">Transparent</Color>
</ResourceDictionary>
