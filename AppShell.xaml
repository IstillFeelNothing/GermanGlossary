<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GermanyGlossary.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GermanyGlossary.Views"
    Title="GermanyGlossary">

    <TabBar>
        <ShellContent
            Title="Слова"
            ContentTemplate="{DataTemplate views:WordsPage}"
            Route="words" />

        <ShellContent
            Title="Картки"
            ContentTemplate="{DataTemplate views:FlashcardsPage}"
            Route="cards" />
    </TabBar>

</Shell>
