<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GermanyGlossary.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GermanyGlossary"
    xmlns:views="clr-namespace:GermanyGlossary.Views"
    Title="GermanyGlossary">

    <!-- On Windows the pages hide this tab bar and show the centered TopNavBar instead. -->
    <TabBar>
        <ShellContent
            Title="Слова"
            Icon="tab_words.png"
            ContentTemplate="{DataTemplate views:WordsPage}"
            Route="{x:Static local:AppShell.WordsRoute}" />

        <ShellContent
            Title="Повторення"
            Icon="tab_cards.png"
            ContentTemplate="{DataTemplate views:FlashcardsPage}"
            Route="{x:Static local:AppShell.CardsRoute}" />
    </TabBar>

</Shell>
